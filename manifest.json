{
  "requiredSdkVersion": "^1.0.0-beta.2",
  "name": "GenericLinkShare",
  "version": "0.1.1",
  "javascriptEntrypointUrl": "GenericLinkShare.js",
  "localesBaseUrl": "https://cdn.domain.com/pluginabc/",
  "dataChannels": [
    {
      "name": "urlToGenericLink",
      "pushPermission": [
        "moderator",
        "presenter"
      ],
      "replaceOrDeletePermission": [
        "creator",
        "moderator",
        "presenter"
      ]
    }
  ],
  "settingsSchema": [
    {
      "name": "defaultUrl",
      "label": "Default URL suggested to the presenter",
      "required": true,
      "defaultValue": "${plugin_GenericLinkShare_default-url:}",
      "type": "string"
    },
    {
      "name": "defaultViewerUrl",
      "label": "Default URL suggested for the viewers",
      "required": true,
      "defaultValue": "${plugin_GenericLinkShare_default-viewer-url:}",
      "type": "string"
    },
    {
      "name": "defaultUrlDescription",
      "label": "Description shown below the default URL",
      "required": true,
      "defaultValue": "${plugin_GenericLinkShare_default-url-description:}",
      "type": "string"
    }
  ]
}
